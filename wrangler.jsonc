{
  "name": "detcord-digital",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GOAT_ARCHIVE",
        "class_name": "GoatArchive"
      }
    ]
  },
  "migrations": [
    {
      "tag": "goat-transcripts-v1",
      "new_sqlite_classes": [
        "GoatArchive"
      ]
    }
  ]
}
