{
  "name": "detcord-digital",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/client-portal*",
      "/portal.js",
      "/portal-contracts.js",
      "/portal-access.js"
    ],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GOAT_ARCHIVE",
        "class_name": "GoatArchive"
      },
      {
        "name": "CLIENT_PORTAL",
        "class_name": "ClientPortal"
      }
    ]
  },
  "migrations": [
    {
      "tag": "goat-transcripts-v1",
      "new_sqlite_classes": [
        "GoatArchive"
      ]
    },
    {
      "tag": "client-portal-v1",
      "new_sqlite_classes": [
        "ClientPortal"
      ]
    }
  ]
}
